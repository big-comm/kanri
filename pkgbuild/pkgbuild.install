#!/usr/bin/env bash
# This file contains scripts that are executed at different stages of package installation/upgrade/removal

# Color definitions for status messages
blueDark="\e[1;38;5;33m"     # Bold dark blue
mediumBlue="\e[1;38;5;32m"   # Bold medium blue
lightBlue="\e[1;38;5;39m"    # Bold light blue
cyan="\e[1;38;5;45m"         # Bold cyan
white="\e[1;97m"             # Bold white
reset="\e[0m"                # Reset text formatting

# Print status messages
printMsg() {
    local message=$1
    echo -e "${blueDark}[${lightBlue}kanri${blueDark}]${reset} ${cyan}→${reset} ${white}${message}${reset}"
}

# Function executed after package installation
post_install() {
    printMsg "Configuring kanri after installation..."
    
    # Create the wrapper script that handles NVIDIA compatibility
    cat > /usr/bin/kanri << 'EOF'
#!/bin/bash
# Wrapper script for kanri to handle compatibility issues

# Check for NVIDIA GPU and set environment variable to avoid rendering issues
if lspci | grep -qi nvidia; then
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi

# Execute the actual kanri binary
exec /usr/lib/kanri/kanri-bin "$@"
EOF
    
    chmod +x /usr/bin/kanri
    printMsg "Wrapper script created with NVIDIA compatibility support"
}

# Function executed after package upgrade
post_upgrade() {
    printMsg "Finalizing package upgrade..."
    # Ensure wrapper is properly configured after upgrade
    post_install
    printMsg "Upgrade completed successfully"
}

# Function executed before package removal
pre_remove() {
    printMsg "Preparing to remove the package..."
    # Remove the wrapper script
    rm -f /usr/bin/kanri
    printMsg "Wrapper script removed"
}

# Function executed after package removal
post_remove() {
    printMsg "Cleaning up after package removal..."
    # Additional cleanup if needed
    printMsg "Package cleanup completed"
}